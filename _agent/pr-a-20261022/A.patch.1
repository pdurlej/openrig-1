diff --git a/packages/cli/src/mcp-server.ts b/packages/cli/src/mcp-server.ts
index 58262be6..1fdbe983 100644
--- a/packages/cli/src/mcp-server.ts
+++ b/packages/cli/src/mcp-server.ts
@@ -628,2 +628,28 @@ export function createMcpServer(client: DaemonClient): McpServer {

+  // 24. rig_events_replay — a page of the daemon's event log after a cursor (the log the SSE stream replays)
+  server.tool(
+    "rig_events_replay",
+    "Read the daemon's event log a page at a time: the events after since, and the nextCursor to pass as since on the next call. A poll, not a live subscription. A since older than the stored log is a cursor_expired error with the resyncCursor to continue from.",
+    {
+      since: z.number().int().nonnegative().optional().describe("Return the events after this seq (default: from the oldest stored)"),
+      rigId: z.string().optional().describe("Only this rig's events (rig name or identifier)"),
+      limit: z.number().int().positive().optional().describe("Page size (default 200, at most 1000)"),
+    },
+    async ({ since, rigId, limit }) => {
+      try {
+        const params = new URLSearchParams();
+        if (since !== undefined) params.set("since", String(since));
+        if (rigId) {
+          const rig = await rigIdFor(client, rigId);
+          if ("content" in rig) return rig;
+          params.set("rigId", rig.id);
+        }
+        if (limit !== undefined) params.set("limit", String(limit));
+        return mapResult(await client.get(`/api/events/replay?${params.toString()}`));
+      } catch (err) {
+        return { content: [{ type: "text" as const, text: (err as Error).message }], isError: true as const };
+      }
+    },
+  );
+
   return server;
diff --git a/packages/cli/test/mcp-events-daemon.test.ts b/packages/cli/test/mcp-events-daemon.test.ts

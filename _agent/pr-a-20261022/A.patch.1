@@ -0,0 +1,73 @@
+// rig_events_replay against the daemon's real events route, through the real DaemonClient: an MCP client that holds no
+// stream reads the event log a page at a time, names the rig as the CLI does, and is told to resync when its cursor is
+// older than the stored log.
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { InMemoryTransport } from "@modelcontextprotocol/sdk/inMemory.js";
+import type Database from "better-sqlite3";
+import { createFullTestDb, createTestApp } from "../../daemon/test/helpers/test-app.js";
+import type { EventBus } from "../../daemon/src/domain/event-bus.js";
+import { DaemonClient } from "../src/client.js";
+import { createMcpServer } from "../src/mcp-server.js";
+
+describe("rig_events_replay on the daemon's events route", () => {
+  let db: Database.Database;
+  let eventBus: EventBus;
+  let rigId: string;
+  let otherRigId: string;
+  let replay: (args: Record<string, unknown>) => Promise<{ isError: boolean; data: Record<string, unknown> }>;
+  let close: () => Promise<void>;
+
+  beforeEach(async () => {
+    db = createFullTestDb();
+    const { app, rigRepo, eventBus: bus } = createTestApp(db);
+    eventBus = bus;
+    rigId = rigRepo.createRig("team").id;
+    otherRigId = rigRepo.createRig("other").id;
+
+    const fetchImpl: typeof fetch = (input, init) => app.request(input instanceof Request ? input.url : String(input), init);
+    const mcp = createMcpServer(new DaemonClient("http://127.0.0.1:9", { fetchImpl }));
+    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+    const client = new Client({ name: "poller", version: "1.0.0" });
+    await mcp.connect(serverTransport);
+    await client.connect(clientTransport);
+    close = async () => { await client.close(); await mcp.close(); };
+    replay = async (args) => {
+      const result = await client.callTool({ name: "rig_events_replay", arguments: args });
+      return { isError: result.isError === true, data: JSON.parse((result.content as Array<{ text: string }>)[0]!.text) };
+    };
+  });
+
+  afterEach(async () => {
+    await close();
+    db.close();
+  });
+
+  const emit = (rig: string, n: number) => eventBus.emit({ type: "node.added", rigId: rig, nodeId: `n${n}`, logicalId: `w${n}` }).seq;
+  const seqs = (data: Record<string, unknown>) => (data.events as Array<{ seq: number }>).map((e) => e.seq);
+
+  it("pages the named rig's events, nextCursor resuming where a page ended", async () => {
+    const a1 = emit(rigId, 1);
+    emit(otherRigId, 2);
+    const a2 = emit(rigId, 3);
+
+    const first = await replay({ rigId: "team", limit: 1 });
+    expect(first.isError).toBe(false);

+  if (expired) return c.json(expired, 410);
+
+  const events = eventBus.replayPage(since, eventBus.maxSeq(), limit, rigId);
+  return c.json({ events, nextCursor: events.at(-1)?.seq ?? since, exhausted: events.length < limit });
+});
